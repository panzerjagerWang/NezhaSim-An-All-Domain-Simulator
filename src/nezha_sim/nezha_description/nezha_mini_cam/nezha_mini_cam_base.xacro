<?xml version="1.0"?>
<!--
  Author: Jiaqing "Lance" Wang <jiaqing.wang@sjtu.edu.cn>
  Shanghai Jiao Tong University, The Nezha Lab
  Key Laboratory of Polar Ecosystem and Climate Change
  State Key Laboratory of Submarine Geoscience
-->

<robot name="iris" xmlns:xacro="http://ros.org/wiki/xacro">
<xacro:property name="namespace" value="$(arg namespace)" />
<xacro:property name="rotor_velocity_slowdown_sim" value="20" />
<xacro:property name="use_mesh_file" value="true" />
<xacro:property name="mesh_file" value="$(find nezha_description)/${namespace}/meshes/${namespace}2.dae"/>
<xacro:property name="visual_mesh_file" value="$(find nezha_description)/${namespace}/meshes/${namespace}.STL"/>
<xacro:property name="mass" value="0.95" /> <!-- [kg] -->
<xacro:property name="body_width" value="0.35" /> <!-- [m] -->
<xacro:property name="body_height" value="0.193" /> <!-- [m] -->
<xacro:property name="mass_rotor" value="0.00348939525186528" /> <!-- [kg] -->
<xacro:property name="arm_length_front_x" value="0.09288" /> <!-- [m] -->
<xacro:property name="arm_length_back_x" value="0.08088" /> <!-- [m] -->
<xacro:property name="arm_length_front_y" value="0.10725" /> <!-- [m] -->
<xacro:property name="arm_length_back_y" value="0.10725" /> <!-- [m] -->
<xacro:property name="rotor_offset_top" value="0.01" /> <!-- [m] -->
<xacro:property name="blade_type" value="thin" /> <!-- [m] -->
<xacro:property name="radius_rotor" value="0.05" /> <!-- [m] -->
<xacro:property name="scale_rotor" value="0.1" /> <!-- [m] -->
<xacro:property name="motor_constant" value="8.54858e-06" /> <!-- [kg.m/s^2] --> 
<xacro:property name="moment_constant" value="0.016" /> <!-- [m] --> 
<xacro:property name="time_constant_up" value="0.0125" /> <!-- [s] --> 
<xacro:property name="time_constant_down" value="0.025" /> <!-- [s] --> 
<xacro:property name="max_rot_velocity" value="838" /> <!-- [rad/s] -->
<xacro:property name="sin30" value="0.5" />
<xacro:property name="cos30" value="0.866025403784" />
<xacro:property name="sqrt2" value="1.4142135623730951" />
<xacro:property name="rotor_drag_coefficient" value="0" />
<xacro:property name="rolling_moment_coefficient" value="0" />
<xacro:property name="paddle_arm_length_front_x" value="0.12853" /> 
<xacro:property name="paddle_arm_length_front_y" value="0.0" />    
<xacro:property name="paddle_arm_length_back_x" value="-0.1392" />  
<xacro:property name="paddle_1_arm_length_back_y" value="0.04424" /> 
<xacro:property name="paddle_2_arm_length_back_y" value="-0.04424" /> 
  <xacro:property name="paddle_offset_top" value="-0.03" /> <!-- [m] -->
  
  <xacro:property name="radius_paddle" value="1" /> <!-- [m] -->
  <xacro:property name="mass_paddle" value="0.003489395251" /> <!-- [kg] -->
  <!-- Property Blocks -->
<xacro:arg name="namespace" default="nezha_mini_cam"/>
<xacro:arg name="debug" default="false"/>
<xacro:arg name="enable_mavlink_interface" default="false"/>
<xacro:arg name="enable_motor_model" default="true"/>

<xacro:include filename="$(find nezha_description)/$(arg namespace)/plugins.xacro" />
  <xacro:include filename="$(find nezha_description)/${namespace}/UAV/UAV.xacro" />
<xacro:include filename="$(find nezha_description)/$(arg namespace)/UUV/UUV.xacro" />

  <xacro:nezha_UAV_UUV_complete
    namespace="${namespace}"
    mass="${mass}"
    body_width="${body_width}"
    body_height="${body_height}"
    use_mesh_file="${use_mesh_file}"
    mesh_file="${mesh_file}"
    inertial_reference_frame="$(arg inertial_reference_frame)"
    debug="$(arg debug)">
    <!-- 惯性参数 -->
    <body_inertia>
      <inertia ixx="0.0339" ixy="0" ixz="0" 
               iyy="0.00076" iyz="0" izz="0.000692"/>
    </body_inertia>
  </xacro:nezha_UAV_UUV_complete>
  
  <!-- 1. Joint connecting the camera to the UAV base -->
  <joint name="stereo_camera_joint" type="fixed">
    <!-- xyz sets the position. z="-0.05" places it 5cm beneath the base_link -->
    <!-- rpy="0 1.57079632679 0" pitches the camera 90 degrees to look straight down -->
    <origin xyz="0.0 0.0 -0.05" rpy="0 1.57079632679 0" />
    <parent link="${namespace}/base_link" /> 
    <child link="stereo_camera_link" />
  </joint>

  <!-- 2. The physical camera link (visual and collision box) -->
  <link name="stereo_camera_link">
    <inertial>
      <!-- Mass reduced from 0.05 to 0.01 -->
      <mass value="0.001" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <!-- A small box representing the stereo camera -->
        <box size="0.02 0.08 0.02" />
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.08 0.02" />
      </geometry>
    </collision>
  </link>

  <!-- 3. Optical Frame Joint (ROS Image Convention: Z forward, X right, Y down) -->
  <joint name="stereo_camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
    <parent link="stereo_camera_link" />
    <child link="stereo_camera_optical_frame" />
  </joint>

  <link name="stereo_camera_optical_frame" />

  <!-- 4. Gazebo Stereo Camera Plugin -->
  <gazebo reference="stereo_camera_link">
    <sensor type="multicamera" name="stereo_camera">
      <update_rate>30.0</update_rate>
      
      <!-- Left Camera -->
      <camera name="left">
        <!-- Offset by half the baseline to the left (y = 0.035) -->
        <pose>0 0.035 0 0 0 0</pose> 
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      
      <!-- Right Camera -->
      <camera name="right">
        <!-- Offset by half the baseline to the right (y = -0.035) -->
        <pose>0 -0.035 0 0 0 0</pose> 
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      
      <!-- Multicamera ROS Plugin -->
      <plugin name="stereo_camera_controller" filename="libgazebo_ros_multicamera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>30.0</updateRate>
        <cameraName>${namespace}/stereo_camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>stereo_camera_optical_frame</frameName>
        <hackBaseline>0.07</hackBaseline> <!-- Total distance between cameras -->
        <distortionK1>0.0</distortionK1>
        <distortionK2>0.0</distortionK2>
        <distortionK3>0.0</distortionK3>
        <distortionT1>0.0</distortionT1>
        <distortionT2>0.0</distortionT2>
      </plugin>
    </sensor>
  </gazebo>


  
  <xacro:apply_nezha_plugins
    namespace="${namespace}"/> 
</robot>

