<?xml version="1.0"?>
<!--
  Author: Jiaqing "Lance" Wang <jiaqing.wang@sjtu.edu.cn>
  Shanghai Jiao Tong University, The Nezha Lab
  Key Laboratory of Polar Ecosystem and Climate Change
  State Key Laboratory of Submarine Geoscience
-->

<robot name="plugin" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="debug" default="false"/>
  <xacro:arg name="mode" default="_f"/>
  <xacro:arg name="namespace" default="nezha_f"/>
    <xacro:property name="buoyancy_scale" value="1.0"/>

  <xacro:property name="namespace" value="$(arg namespace)"/>
  <xacro:arg name="inertial_reference_frame" default="world"/>
         
  <xacro:property name="buoyancy_scale" value="1.0"/>       
  <xacro:property name="force_scale_factor" value="1.0"/>     

      
<xacro:property name="body_inertia">
  <inertia ixx="0.0347563" ixy="0.0" ixz="0.0" iyy="0.0458929" iyz="0.0" izz="0.0977" />
</xacro:property>
  <!-- inertia of a single rotor, assuming it is a cuboid. Height=3mm, width=15mm -->
  <xacro:property name="rotor_inertia">
    <xacro:box_inertia x="${radius_rotor}" y="0.015" z="0.003" mass="${mass_rotor*rotor_velocity_slowdown_sim}" />
  </xacro:property>
  
  
  <xacro:macro name="terrain_detector_macro" 
               params="robot_namespace 
                       link_name:=base_link 
                       update_rate:=1.0 
                       topic_name:=terrain_status
                       extra_keywords:=''">
    <gazebo>
      <plugin name="terrain_detector_${robot_namespace}" filename="libnezha_terrain_detector_plugin.so">
        <robotNamespace>${robot_namespace}</robotNamespace>
        <linkName>${link_name}</linkName>
        <updateRate>${update_rate}</updateRate>
        <terrainPubTopic>${topic_name}</terrainPubTopic>
        <xacro:if value="${extra_keywords != ''}">
          <waterKeywords>${extra_keywords}</waterKeywords>
            <waterSurfaceLevel>0.0</waterSurfaceLevel>
  <surfaceTolerance>0.2</surfaceTolerance>
    <ktIgeGainPubTopic>kt_ige_gain</ktIgeGainPubTopic>
  <kqIgeGainPubTopic>kq_ige_gain</kqIgeGainPubTopic>
        </xacro:if>
      </plugin>
    </gazebo>
  </xacro:macro>
  
  
  <xacro:macro name="nezha_UAV_UUV_complete" 
    params="namespace mass body_width body_height use_mesh_file mesh_file 
            inertial_reference_frame debug *body_inertia">
    
    <link name="${namespace}/base_link"></link>

    <joint name="${namespace}/base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${namespace}/base_link" />
      <child link="${namespace}/base_link_inertia" />
    </joint>

    <link name="${namespace}/base_link_inertia">
      <inertial>
        <mass value="${mass}" />
        <origin xyz="0 0 -0.05" />
        <xacro:insert_block name="body_inertia" />
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <xacro:if value="${use_mesh_file}">
            <mesh filename="${mesh_file}" scale="1 1 1" />
          </xacro:if>
          <xacro:unless value="${use_mesh_file}">
            <box size="${body_width} ${body_width} ${body_height}"/>
          </xacro:unless>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${body_width} ${body_width} ${body_height}" />
        </geometry>
      </collision>
    </link>
    <gazebo>
      <plugin filename="librotors_gazebo_multirotor_base_plugin.so" 
              name="multirotor_base_plugin">
        <robotNamespace>${namespace}</robotNamespace>
        <linkName>${namespace}/base_link</linkName>
        <rotorVelocitySlowdownSim>${rotor_velocity_slowdown_sim}</rotorVelocitySlowdownSim>
      </plugin>
    </gazebo>
    <!-- ============================================================
         BASELINE: genuine UUV_simulator hydrodynamics plugin
         (upstream uuv_underwater_object_ros_plugin, Fossen model), with
         NO Phase Switch Console and NO Transmedium-Resistance (TR) drag
         model. Plain UUV-Simulator: a single infinite ocean half-space.
         Fossen coefficients are kept identical to the XXSim XX-F
         (nezha_f) so only the engine differs.
         ============================================================ -->
    <gazebo>
      <plugin name="uuv_plugin" filename="libuuv_underwater_object_ros_plugin.so">
        <fluid_density>1028.0</fluid_density>
        <flow_velocity_topic>hydrodynamics/current_velocity</flow_velocity_topic>
        <debug>1</debug>
        <xacro:uuv_baseline_hydro_model namespace="${namespace}"/>
      </plugin>
    </gazebo>
  </xacro:macro>
      <xacro:property name="cob" value="0 0 0.1"/>
        <xacro:property name="volume" value="0.0021"/>  <!-- BASELINE: ~neutral/slightly positive (weight 19.6N, buoyancy ~21N) so the F floats to the surface at idle instead of sinking to the lake bottom and NaN-crashing gzserver. -->
<xacro:macro name="uuv_baseline_hydro_model" params="namespace">
        <link name="${namespace}/base_link">
            <neutrally_buoyant>0</neutrally_buoyant>
            <volume>${volume}</volume>
            <box>
                <width>0.05</width>
                <length>0.15</length>
                <height>0.11</height>
            </box>
            <center_of_buoyancy>${cob}</center_of_buoyancy>
<hydrodynamic_model>
    <type>fossen</type>
    <!-- nezha_f Fossen coefficients, in the uuv_simulator sign convention (negated) -->
    <added_mass>
        -0.29 0     0     0       0       0
        0    -0.29  0     0       0       0
        0     0    -0.49  0       0       0
        0     0     0    -0.0005  0       0
        0     0     0     0      -0.0011  0
        0     0     0     0       0      -0.0023
    </added_mass>

    <linear_damping>
        -1.0 -1.0 -2.0 -0.1 -0.15 -0.15
    </linear_damping>

    <quadratic_damping>
        -1.0 -1.0 -2.0 -1.0 -1.5 -1.5
    </quadratic_damping>

    <max_force>100.0</max_force>
    <max_torque>100.0</max_torque>
</hydrodynamic_model>
        </link>
    </xacro:macro>
  
  <xacro:macro name="wave_probe_plugin" params="
    plugin_name:=wave_probe
    namespace:=''
    L:=1.0
    z_offset:=0.0
    bound_link:=base_link
    wavefield_name:=nezha_ocean_waves">  
    <gazebo>
      <plugin name="${plugin_name}" filename="libnezha_wave_probe_plugin.so">
        <robotNamespace>${namespace}</robotNamespace>
        <L>${L}</L>
        <zTopOffset>${z_offset}</zTopOffset>
        <boundName>${bound_link}</boundName>
        <wavefieldCandidate>${wavefield_name}</wavefieldCandidate>
      </plugin>
    </gazebo>
  </xacro:macro>
<xacro:macro name="phase_switch_plugin" params="
  namespace:=rexrov
  target_link:=base_link
  update_rate:=50.0
  transition_frames:=5
  surface_plugin_name:=hydrodynamics
  underwater_plugin_name:=uuv_plugin
  surface_plugin_file:=libnezha_surface_plugin.so
  underwater_plugin_file:=libnezha_underwater_plugin.so
">
  <gazebo>
    <plugin name="phase_switch_plugin" 
            filename="libnezha_phase_switch_plugin.so">

      <robot_namespace>${namespace}</robot_namespace>
      <target_link>${target_link}</target_link>

      <update_rate>${update_rate}</update_rate>
      <transition_frames>${transition_frames}</transition_frames>
      
      <surface_plugin_name>${surface_plugin_name}</surface_plugin_name>
      <underwater_plugin_name>${underwater_plugin_name}</underwater_plugin_name>
      
      <surface_plugin_file>${surface_plugin_file}</surface_plugin_file>
      <underwater_plugin_file>${underwater_plugin_file}</underwater_plugin_file>

    </plugin>
  </gazebo>
  
</xacro:macro>
<!-- ========================================
     Robot State Plugin Macro
     ======================================== -->
<xacro:macro name="RobotStatePlugin" params="model_namespace">
  <gazebo>
    <plugin name="RobotStatePlugin" filename="libnezha_robot_state_plugin.so">
      <namespace>${model_namespace}</namespace>
    </plugin>
  </gazebo>
</xacro:macro>

<!-- ========================================
     Hydrodynamics Plugin Macro
     ======================================== -->
<!-- ========================================
     Hydrodynamics Plugin Macro
     ======================================== -->
<xacro:macro name="hydrodynamics_plugin" 
             params="wave_model:='nezha_ocean_waves'
                     debug:=false
                     robot_volume:=${volume}
                     buoyancy_scale:=1.0
                     force_scale_factor:=1.0
                     water_patch_length:=5.0
                     water_patch_width:=5.0
                     ">
<gazebo>
  <plugin name="hydrodynamics_plugin" filename="libnezha_surface_plugin.so">
    <!-- 波浪模型 -->
    <wave_model>nezha_ocean_waves</wave_model>
    
    <!-- 机器人体积 -->
    <robot_volume>0.0018</robot_volume>
    <buoyancy_scale>1.0</buoyancy_scale>
    <force_scale_factor>0.5</force_scale_factor>
    
<hydrodynamic_model>
    <type>fossen</type>
    
    <!-- ✅ 修正1: 去掉负号，质量必须为正 -->
    <added_mass>
        0.29 0    0    0       0       0
        0    0.29 0    0       0       0
        0    0    0.49 0       0       0
        0    0    0    0.0005  0       0
        0    0    0    0       0.0011  0
        0    0    0    0       0       0.0023
    </added_mass>

    <!-- ✅ 修正2: 增大阻尼，特别是后三个旋转项，防止震荡 -->
<linear_damping>
    1.0 1.0 2.0 0.1 0.15 0.15 <!-- 增大X方向阻尼（第一个值） -->
</linear_damping>

    <quadratic_damping>
        1.0 1.0 2.0 1.0 1.5 1.5
    </quadratic_damping>

    <max_force>100.0</max_force>
    <max_torque>100.0</max_torque>
</hydrodynamic_model>
    
    <!-- 水面网格 -->
    <length>2.0</length>
    <width>2.0</width>
    
    <!-- 可视化 -->
    <markers>
      <update_rate>30.0</update_rate>
      <water_patch>false</water_patch>
      <waterline>false</waterline>
      <underwater_surface>false</underwater_surface>
    </markers>
  </plugin>
</gazebo>
</xacro:macro>


<!-- ========================================
     ✅ 统一的插件应用宏
     ======================================== -->
<!-- ========================================
     ✅ 统一的插件应用宏
     ======================================== -->
<xacro:macro name="apply_nezha_plugins" params="
  namespace
  target_link:=base_link
  wave_model:=nezha_ocean_waves
  debug:=false
">
  
  <!-- ============================================================
       BASELINE: NO NASV surface plugin, NO Phase Switch Console and
       NO Transmedium-Resistance drag. Hydrodynamics come solely from
       the genuine UUV_simulator plugin (uuv_plugin, defined in
       nezha_UAV_UUV_complete). This is the plain upstream UUV-Simulator.
       ============================================================ -->

  <!-- ========================================
       4️⃣ Wave Probe Plugin (波浪探测)
       - 提供实时的水面高度和相态信息
       - Phase Switch 通过 ROS 服务查询此插件
       ======================================== -->
  <xacro:wave_probe_plugin 
    plugin_name="usv_wave_probe"
    namespace="${namespace}"
    L="2.5"
    z_offset="0.1"
    bound_link="${namespace}/${target_link}"
    wavefield_name="${wave_model}::wavefield_entity"/>
  
  <!-- ========================================
       5️⃣ Robot State Plugin (机器人状态发布)
       - 发布机器人的位姿、速度等信息
       ======================================== -->
  <xacro:RobotStatePlugin model_namespace="${namespace}"/>
<xacro:terrain_detector_macro 
  robot_namespace="$(arg namespace)" 
  link_name="${namespace}/base_link"
  update_rate="2.0"
  extra_keywords="puddle,basin,aquarium"/>
</xacro:macro>
  <xacro:nezha_UAV_UUV_complete
    namespace="${namespace}"
    mass="${mass}"
    body_width="${body_width}"
    body_height="${body_height}"
    use_mesh_file="${use_mesh_file}"
    mesh_file="${mesh_file}"
    inertial_reference_frame="$(arg inertial_reference_frame)"
    debug="$(arg debug)">
    <!-- 惯性参数 -->
    <body_inertia>
      <inertia ixx="0.002678" ixy="0" ixz="0" 
               iyy="0.002678" iyz="0" izz="0.001983"/>
    </body_inertia>
  </xacro:nezha_UAV_UUV_complete>
  <xacro:apply_nezha_plugins
    namespace="${namespace}"/> 
</robot>



