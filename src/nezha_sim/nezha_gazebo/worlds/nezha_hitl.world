<?xml version="1.0" ?>
<!--
  Lightweight world for PX4 hardware-in-the-loop (aerial) testing.
  - No water/lake: avoids buoyancy bobbing that destabilises the EKF height.
  - Coarse, real-time-friendly physics (5 ms step, 200 Hz, 20 solver iters) so
    gazebo holds RTF ~= 1.0 on a single core. HITL is wall-clock (no lockstep),
    so the sim MUST keep up or PX4 times out the slower sensors (mag/baro).
-->
<sdf version="1.6">
  <world name="nezha_hitl">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- GPS/groundtruth/magnetometer origin (PX4 default home, Zurich).
         Matches the mavlink_interface reference lat/lon in the model.
         Override at runtime with PX4_HOME_LAT / PX4_HOME_LON / PX4_HOME_ALT. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.3977418</latitude_deg>
      <longitude_deg>8.5455938</longitude_deg>
      <elevation>488.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>20</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
  </world>
</sdf>
